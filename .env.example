# .env namunasi: nusxa oling (cp .env.example .env) va qiymatlarni to'ldiring.
# .env git'ga tushmaydi. Server uni avtomatik o'qiydi (spring.config.import),
# haqiqiy muhit o'zgaruvchilari esa .env dagi qiymatlardan ustun turadi.

# --- Server ---
SERVER_PORT=8888

# --- PostgreSQL ---
# docker-compose.yml ham, server ham shu qiymatlarni ishlatadi.
# Server JDBC URL ni ulardan yig'adi; to'liq URL kerak bo'lsa SALESDOCTOR_DB_URL ni bering.
SALESDOCTOR_DB_HOST=localhost
SALESDOCTOR_DB_PORT=5432
SALESDOCTOR_DB_NAME=salesdoctor_db
SALESDOCTOR_DB_USER=salesdoctor
SALESDOCTOR_DB_PASSWORD=salesdoctor_pass

# --- JWT ---
# Kamida 32 bayt. Yaratish: openssl rand -hex 32
SALESDOCTOR_JWT_SECRET=
SALESDOCTOR_JWT_ISSUER=salesdoctor-mcp

# --- MCP mijoz (Claude Code, .mcp.json) ---
# Yaratish: ./mvnw -q compile exec:java -Dexec.args="--subject claude-code --days 30"
# (kalitni shu fayldagi SALESDOCTOR_JWT_SECRET dan oladi)
SALESDOCTOR_MCP_TOKEN=
